{
  "name": "service-provider-onboarding",
  "version": "1.0.0",
  "private": true,
  "description": "Trizen — Service Provider Onboarding Portal",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "seed:admin": "npm run seed:admin --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
